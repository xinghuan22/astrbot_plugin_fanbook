{
    "iqdb_use_proxy": {
        "description": "IQDB 是否使用代理",
        "type": "bool",
        "default": false,
        "hint": "开启后，IQDB 会话初始化、搜图和缩略图下载都通过下方代理地址访问"
    },
    "iqdb_proxy": {
        "description": "IQDB 代理地址",
        "type": "string",
        "default": "",
        "hint": "例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:7890"
    },
    "image_gateway_url": {
        "description": "图片结果页面地址",
        "type": "string",
        "default": "https://image.lospro.kissnab.top",
        "hint": "支持的 IQDB 图源会转换为此服务的 /view?url= 地址"
    },
    "manga_publish_secret": {
        "description": "漫画发布密钥",
        "type": "string",
        "default": "",
        "hint": "须与 image-gateway 的 MANGA_PUBLISH_SECRET 完全相同，至少 32 个字符"
    }
}
